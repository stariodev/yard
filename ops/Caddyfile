# Yard's main Caddyfile. Caddy reads it at start; Yard loads it again after each site change.
# Each app's site lives in /config/sites/<app>.caddy. Yard writes those files; Caddy checks them.
{
	admin unix//run/caddy/admin.sock
	# Caddy listens on 443 only. The host forwards public 443 to it; port 80 stays closed.
	auto_https disable_redirects
	cert_issuer acme {
		disable_http_challenge
	}
	servers :443 {
		protocols h1 h2 h3
	}
}

import /config/sites/*.caddy
